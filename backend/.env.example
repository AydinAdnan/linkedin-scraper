PORT=4000
FRONTEND_URL=http://localhost:5173

# populated by `npm run login` — never commit real values
LI_AT=
LI_JSESSIONID=
LI_USER_AGENT=

# base ms delay between LinkedIn requests (random jitter added on top);
# raise this if you're seeing frequent COOKIES_EXPIRED / redirect failures
REQUEST_DELAY_MS=3000

# requests/minute allowed per IP
RATE_LIMIT_MAX=20

# LinkedIn versions this server-side; bump if profile fetches start failing
# (capture the current value from a real browser's network tab)
PROFILE_DECORATION_ID=com.linkedin.voyager.dash.deco.identity.profile.FullProfileWithEntities-93
